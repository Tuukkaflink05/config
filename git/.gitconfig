[core]
autocrlf = false
[user]
name = Tuukka Flink
email = tuukka.flink@icloud.com
[alias]
co = commit
st = status
lg = "log --date=short --pretty=format:'%ci %s'"


[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
